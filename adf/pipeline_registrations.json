{ "name": "incremental_7day_registrations_pipeline", "properties": { "parameters": { "run_date": { "type": "String", "defaultValue": "@utcNow()" }, "window_days": { "type": "Int", "defaultValue": 7 }, "run_id": { "type": "String", "defaultValue": "@concat('run_',formatDateTime(utcNow(),'yyyyMMddHHmmss'))" } }, "variables": { "start_date": { "type": "String" }, "end_date": { "type": "String" } }, "activities": [ { "name": "SetWindow", "type": "SetVariable", "typeProperties": { "variables": [ { "name": "start_date", "value": "@formatDateTime(addDays(pipeline().parameters.run_date, -pipeline().parameters.window_days), 'yyyy-MM-dd')" }, { "name": "end_date", "value": "@formatDateTime(pipeline().parameters.run_date, 'yyyy-MM-dd')" } ] } }, { "name": "Copy_Registrations", "type": "Copy", "dependsOn": [{ "activity": "SetWindow", "dependencyConditions": ["Succeeded"] }], "linkedServiceName": { "referenceName": "LS_OnPrem_SQL_SHIR", "type": "LinkedServiceReference" }, "typeProperties": { "source": { "type": "SqlSource", "sqlReaderQuery": "SELECT * FROM dbo.patient_registrations WHERE modified_at >= '@{variables('start_date')}' AND modified_at < '@{variables('end_date')}'" }, "sink": { "type": "AzureBlobFS", "copyBehavior": "PreserveHierarchy", "blobWriterAddHeader": true } }, "inputs": [{ "referenceName": "DS_OnPrem_Registrations_Query", "type": "DatasetReference" }], "outputs": [{ "referenceName": "DS_Adls_Incoming_Registrations", "type": "DatasetReference" }] }, { "name": "Run_Databricks_Ingest", "type": "DatabricksNotebook", "dependsOn": [{ "activity": "Copy_Registrations", "dependencyConditions": ["Succeeded"] }], "linkedServiceName": { "referenceName": "LS_AzureDatabricks", "type": "LinkedServiceReference" }, "typeProperties": { "notebookPath": "/Repos/ingest/ingest_and_merge_registrations", "baseParameters": { "run_path": "@concat('abfss://incoming@<STORAGE>.dfs.core.windows.net/registrations/run=', pipeline().parameters.run_id, '/')", "processed_base": "abfss://processed@<STORAGE>.dfs.core.windows.net/", "run_id": "@pipeline().parameters.run_id" } } }, { "name": "Archive_Raw", "type": "Copy", "dependsOn": [{ "activity": "Run_Databricks_Ingest", "dependencyConditions": ["Succeeded"] }], "typeProperties": { "source": { "type": "BinarySource" }, "sink": { "type": "AzureBlobFS" } }, "inputs": [{ "referenceName": "DS_Adls_Incoming_Registrations", "type": "DatasetReference" }], "outputs": [{ "referenceName": "DS_Adls_Archive_Registrations", "type": "DatasetReference" }] }, { "name": "Write_Run_Metadata", "type": "StoredProcedure", "dependsOn": [{ "activity": "Archive_Raw", "dependencyConditions": ["Succeeded"] }], "linkedServiceName": { "referenceName": "LS_AzureSQL_Control", "type": "LinkedServiceReference" }, "typeProperties": { "storedProcedureName": "usp_InsertRunRecord", "storedProcedureParameters": { "run_id": { "value": "@pipeline().parameters.run_id", "type": "String" }, "pipeline_name": { "value": "incremental_7day_registrations_pipeline", "type": "String" }, "status": { "value": "Succeeded", "type": "String" } } } } ] } }